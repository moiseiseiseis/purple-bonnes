# =============================================================================
# PURPLE BONNES — Variables de entorno
# Copia este archivo como .env para desarrollo local.
# En producción (Vercel), configura cada variable en:
#   Dashboard → tu proyecto → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS — Neon PostgreSQL
# Fuente: dashboard.neon.tech → tu proyecto → Connection Details
#
# DATABASE_URL  → usa la cadena "Pooled" (con ?pgbouncer=true&connect_timeout=10)
# DIRECT_URL    → usa la cadena "Direct" (sin pooler); Prisma la necesita para
#                 ejecutar migraciones cuando DATABASE_URL pasa por PgBouncer
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN DEL PANEL ADMIN — Basic Auth HTTP
# El middleware protege /admin y /api/admin con estas credenciales.
# Elige valores seguros; no uses los de ejemplo en producción.
# -----------------------------------------------------------------------------
ADMIN_USER="purplebonnes"
ADMIN_PASSWORD="cambia-esta-contrasena"

# -----------------------------------------------------------------------------
# CLOUDINARY — Almacenamiento de imágenes
# Fuente: console.cloudinary.com → Settings → API Keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# -----------------------------------------------------------------------------
# STRIPE — Pagos
# Fuente: dashboard.stripe.com → Developers → API Keys
#
# DESARROLLO: usa claves que empiecen con sk_test_ / pk_test_
# PRODUCCIÓN: usa claves que empiecen con sk_live_ / pk_live_
#
# STRIPE_WEBHOOK_SECRET → Fuente: dashboard.stripe.com → Webhooks → tu endpoint
#   URL del webhook en Vercel: https://TU-DOMINIO/api/webhooks/stripe
#   Evento a registrar: checkout.session.completed
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# URL PÚBLICA DEL SITIO
# Usada para construir las URLs de success/cancel en el checkout de Stripe.
# En Vercel puedes usar la variable de sistema: VERCEL_PROJECT_PRODUCTION_URL
# Ejemplo: https://purplebonnes.com  (sin barra al final)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"

# -----------------------------------------------------------------------------
# RESEND — Envío de emails (formulario de contacto)
# Fuente: resend.com → API Keys
#
# RESEND_FROM    → remitente verificado en Resend.
#                  Durante pruebas puedes usar "onboarding@resend.dev".
#                  En producción debe ser un email de tu dominio verificado,
#                  ej. "noreply@purplebonnes.com"
# CONTACT_EMAIL  → email donde recibirás los mensajes del formulario
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM="noreply@tu-dominio.com"
CONTACT_EMAIL="tu@email.com"
